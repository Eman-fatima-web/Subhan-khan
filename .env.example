# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# Gmail account that SENDS the email (can be the same as EMAIL_TO)
EMAIL_USER=
# Gmail "App Password" (16 characters) - NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be ON)
EMAIL_PASSWORD=
# Mail provider preset understood by Nodemailer
EMAIL_SERVICE=gmail
# Inbox that RECEIVES contact-form messages
EMAIL_TO=hr.skdigitalsolution@gmail.com

# Optional: use a custom SMTP server instead of EMAIL_SERVICE
# EMAIL_HOST=
# EMAIL_PORT=465

# Server
PORT=3000
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx...)
# TRUST_PROXY=1
